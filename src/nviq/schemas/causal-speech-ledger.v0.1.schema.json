{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://noct-tech.example/spec/nviq/v0.1/causal-speech-ledger.schema.json",
  "title":"NVIQ Causal Speech Ledger v0.1",
  "type":"object","additionalProperties":false,
  "required":["ledger_version","case_id","events"],
  "properties":{"ledger_version":{"const":"0.1"},"case_id":{"type":"string","pattern":"^NVIQ-[A-Z0-9_-]+$"},"events":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/event"}}},
  "$defs":{"event":{"type":"object","additionalProperties":false,
    "required":["event_id","kind","event_time_ms","evidence_available_time_ms","provenance_refs"],
    "properties":{
      "event_id":{"type":"string","minLength":1},
      "kind":{"enum":["acoustic_evidence","representation","hypothesis","confidence","commitment","shared_state_write","reasoning","tool_action","spoken_consequence","revision"]},
      "event_time_ms":{"type":"number","minimum":0},"append_sequence":{"type":"integer","minimum":0},"evidence_available_time_ms":{"type":"number","minimum":0},
      "interpretation_time_ms":{"type":["number","null"],"minimum":0},"confidence_time_ms":{"type":["number","null"],"minimum":0},
      "commitment_time_ms":{"type":["number","null"],"minimum":0},"shared_state_write_time_ms":{"type":["number","null"],"minimum":0},
      "action_authorized_time_ms":{"type":["number","null"],"minimum":0},"spoken_consequence_time_ms":{"type":["number","null"],"minimum":0},
      "revision_time_ms":{"type":["number","null"],"minimum":0},"confidence":{"type":["number","null"],"minimum":0,"maximum":1},
      "fabricated":{"type":"boolean","default":false},"value":{"type":["string","number","boolean","object","array","null"]},
      "parent_event_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true,"default":[]},
      "supersedes_event_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true,"default":[]},
      "does_not_supersede_event_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true,"default":[]},
      "parent_state_hashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[a-f0-9]{64}$"},"default":{}},
      "state_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
      "provenance_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}
    }
  }}
}